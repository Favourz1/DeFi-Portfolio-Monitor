# Backend Environment Variables
# Copy this file to .env and add your actual values

# Server Configuration
NODE_ENV=development
PORT=3001
BASE_URL=http://localhost:3001

# Alchemy API Keys (Get from https://www.alchemy.com/)
ALCHEMY_API_KEY_MAINNET=
ALCHEMY_API_KEY_SEPOLIA=

# Etherscan API Keys (Get from https://etherscan.io/apis)
ETHERSCAN_API_KEY=

# CoinGecko API Key 
COINGECKO_API_KEY=

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=10

# CORS
CORS_ORIGIN=http://localhost:5173


# Add your blockchain API keys here
# Examples: Alchemy, Etherscan, CoinGecko, Moralis, etc.

# ALCHEMY_API_KEY=your_alchemy_key_here
# ETHERSCAN_API_KEY=your_etherscan_key_here
# COINGECKO_API_KEY=your_coingecko_key_here